<div id=3D"data-pro-processing" class=3D"section level2">
<h2>Data Pro-Processing</h2>
<div id=3D"read-raw-data" class=3D"section level3">
<h3>Read raw data</h3>
<pre class=3D"r"><code class=3D"hljs">tree &lt;- read.tree(<span class=3D"h=
ljs-string">"../data/example.tre"</span>)

trait &lt;- read.csv(
  <span class=3D"hljs-string">"../data/trait data.csv"</span>,
  stringsAsFactors =3D <span class=3D"hljs-literal">FALSE</span>
)

my.sample &lt;- read.csv(
  <span class=3D"hljs-string">"../data/community data.csv"</span>,
  stringsAsFactors =3D <span class=3D"hljs-literal">FALSE</span>
)</code></pre>
</div>
<div id=3D"harmonize-species-names-between-tree-and-community-data" class=
=3D"section level3">
<h3>Harmonize species names between tree and community data</h3>
<pre class=3D"r"><code class=3D"hljs"><span class=3D"hljs-comment"># Conver=
t underscores in tree tip labels to periods to match the community data.</s=
pan>
tree_species &lt;- str_replace_all(
  tree$tip.label,
  <span class=3D"hljs-string">"_"</span>,
  <span class=3D"hljs-string">"."</span>
)

community_species &lt;- colnames(my.sample)

<span class=3D"hljs-comment"># Identify tree species whose names do not hav=
e a unique match in the</span>
<span class=3D"hljs-comment"># community dataset.</span>
unmatched_index &lt;- which(
  !tree_species %<span class=3D"hljs-keyword">in</span>% community_species
)

<span class=3D"hljs-comment"># Manually correct known species-name mismatch=
es.</span>
tree_species[unmatched_index] &lt;- c(
  <span class=3D"hljs-string">"Astragalus.dasyanthus.exscapus"</span>,
  <span class=3D"hljs-string">"Populus.alba...P..x.canescens"</span>,
  <span class=3D"hljs-string">"Capsella.bursa.pastoris"</span>,
  <span class=3D"hljs-string">"Festuca.rupicola.valesiaca"</span>,
  <span class=3D"hljs-string">"Stipa.borysthenica.capillata"</span>
)

tree$tip.label &lt;- tree_species</code></pre>
</div>
<div id=3D"filter-community-data-by-removing-rare-species" class=3D"section=
 level3">
<h3>Filter community data by removing rare species</h3>
<pre class=3D"r"><code class=3D"hljs"><span class=3D"hljs-comment"># Keep s=
pecies missing in less than rare_threshold of plots.</span>
zero_threshold &lt;- <span class=3D"hljs-number">0.55</span>
zero_prop &lt;- colMeans(
  my.sample =3D=3D <span class=3D"hljs-number">0</span>,
  na.rm =3D <span class=3D"hljs-literal">TRUE</span>
)

<span class=3D"hljs-comment"># my.sample.filtered &lt;- my.sample %&gt;%</s=
pan>
<span class=3D"hljs-comment">#   select(</span>
<span class=3D"hljs-comment">#     where(~ TRUE)</span>
<span class=3D"hljs-comment">#   )</span>

<span class=3D"hljs-comment"># Apply the occurrence filter only to species =
columns.</span>
species_columns &lt;- colnames(my.sample)[-c(<span class=3D"hljs-number">1<=
/span>, <span class=3D"hljs-number">2</span>)]

species_to_keep &lt;- species_columns[
  zero_prop[species_columns] &lt;=3D zero_threshold=20
]

my.sample.filtered &lt;- my.sample %&gt;%
  select(
    all_of(colnames(my.sample)[<span class=3D"hljs-number">1</span>:<span c=
lass=3D"hljs-number">2</span>]),
    all_of(species_to_keep)
  )


<span class=3D"hljs-comment"># Species retained for the model.</span>
selected_species &lt;- colnames(
  my.sample.filtered
)[-c(<span class=3D"hljs-number">1</span>, <span class=3D"hljs-number">2</s=
pan>)]

<span class=3D"hljs-comment"># The number if species retained for the model=
</span>
p &lt;- length(selected_species)</code></pre>
<p>Species present more than 45% of all the plots are kept.</p>
</div>
<div id=3D"convert-community-data-to-long-format" class=3D"section level3">
<h3>Convert community data to long format</h3>
<pre class=3D"r"><code class=3D"hljs">yX &lt;- reshape(
  my.sample.filtered,
  direction =3D <span class=3D"hljs-string">"long"</span>,
  varying =3D selected_species,
  v.names =3D <span class=3D"hljs-string">"y"</span>,
  timevar =3D <span class=3D"hljs-string">"sp"</span>,
  times =3D selected_species
)

<span class=3D"hljs-comment"># Convert grouping variables to factors.</span=
>
yX[c(<span class=3D"hljs-string">"sp"</span>, <span class=3D"hljs-string">"=
Site"</span>, <span class=3D"hljs-string">"Community"</span>, <span class=
=3D"hljs-string">"id"</span>)] &lt;-
  lapply(
    yX[c(<span class=3D"hljs-string">"sp"</span>, <span class=3D"hljs-strin=
g">"Site"</span>, <span class=3D"hljs-string">"Community"</span>, <span cla=
ss=3D"hljs-string">"id"</span>)],
    factor
  )

<span class=3D"hljs-comment"># Convert percentage cover to proportions.</sp=
an>
yX$y &lt;- yX$y / <span class=3D"hljs-number">100</span>

<span class=3D"hljs-comment"># ordBeta requires values strictly between 0 a=
nd 1.</span>
yX$y[yX$y &gt;=3D <span class=3D"hljs-number">1</span>] &lt;- <span class=
=3D"hljs-number">0.9999</span></code></pre>
</div>
</div>
<div id=3D"distance-and-similarity-matrices" class=3D"section level2">
<h2>Distance and Similarity Matrices</h2>
<pre class=3D"r"><code class=3D"hljs"><span class=3D"hljs-comment"># Keep o=
nly species present in the filtered community dataset.</span>
subtree &lt;- keep.tip(
  tree,
  selected_species
)
<span class=3D"hljs-comment"># Replace species labels</span>
subtree_plot &lt;- subtree
subtree_plot$tip.label &lt;- paste0(<span class=3D"hljs-string">"sp"</span>=
, seq_along(subtree_plot$tip.label))

plot(subtree_plot)</code></pre>
