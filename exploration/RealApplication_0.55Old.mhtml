<pre class=3D"r"><code class=3D"hljs"><span class=3D"hljs-comment">## Rando=
mized Rao's Q diversity for reference</span>
<span class=3D"hljs-comment"># Ensure that the abundance matrix has the sam=
e species and ordering as the</span>
<span class=3D"hljs-comment"># phylogenetic distance matrix.</span>
<span class=3D"hljs-comment"># Calculate SES of Rao's Q using tip randomiza=
tion.</span>
RaosQ_rand &lt;- randomization(
  abundance =3D abundance,
  DM_phy_func =3D DM_phy_func
)

<span class=3D"hljs-comment"># Combine randomized Rao's Q values with commu=
nity groups.</span>
RaosQ_rand_data &lt;- data.frame(
  group =3D my.sample.filtered$Community,
  value =3D RaosQ_rand
)

fig1 &lt;- Boxplot(data =3D RaosQ_rand_data,
                group_levels =3D c(
      <span class=3D"hljs-string">"LF"</span>,
      <span class=3D"hljs-string">"MF"</span>,
      <span class=3D"hljs-string">"SF"</span>,
      <span class=3D"hljs-string">"NE"</span>,
      <span class=3D"hljs-string">"SE"</span>,
      <span class=3D"hljs-string">"CG"</span>,
      <span class=3D"hljs-string">"OP"</span>,
      <span class=3D"hljs-string">"OA"</span>
    ),
    ylab =3D <span class=3D"hljs-string">"Randomized Rao's Q"</span>)
fig1</code></pre>
