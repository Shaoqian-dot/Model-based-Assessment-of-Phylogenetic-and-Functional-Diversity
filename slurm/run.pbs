#!/bin/bash

#PBS -N my_simulations
#PBS -l mem=4gb
#PBS -l walltime=11:59:59
#PBS -J 1-1000
#PBS -o logs/
#PBS -e logs/
#PBS -j oe

cd $PBS_O_WORKDIR

module purge
module add r/4.5.1

echo "Job started: $PBS_JOBID"
echo "Array index: $PBS_ARRAY_INDEX"

############################################################
## Generate seed from array index
## (ensures unique reproducible simulations)
############################################################

BASE_SEED=1000
SEED=$((BASE_SEED + PBS_ARRAY_INDEX - 1))

echo "Using seed: $SEED"

############################################################
## Run simulation
############################################################

Rscript scripts/main_Test_Katana.R \
  $SEED

echo "Job finished"